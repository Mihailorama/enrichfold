{
  "name": "@mihailorama/enrichfold",
  "version": "0.1.0",
  "description": "Provider-neutral, provenance-first entity enrichment for TypeScript.",
  "license": "MIT",
  "author": "Mihail R.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mihailorama/enrichfold.git",
    "directory": "packages/node"
  },
  "homepage": "https://github.com/Mihailorama/enrichfold#readme",
  "bugs": {
    "url": "https://github.com/Mihailorama/enrichfold/issues"
  },
  "keywords": [
    "enrichment",
    "entity-resolution",
    "provenance",
    "research",
    "identity"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
